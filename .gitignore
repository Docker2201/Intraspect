.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# --- Chekator build (local only, run launch/build.ps1) ---
launch/cache/
launch/staging/
launch/CNC_Modeling_build/
launch/Intraspect_Extended_*/
launch/Intraspect/
# Готовая программа для запуска без сборки: exe, app и runtime лежат в репо,
# а данные пользователя и журналы, которые она создаёт рядом с exe, — нет.
launch/Intraspect-Windows-x64/data/
launch/Intraspect-Windows-x64/*.log
!launch/Intraspect-Windows-x64/**/*.jar
launch/CNC_Modeling/app/occt/
# Портативные пользовательские данные (настройки, история, инструменты) — рядом с exe
launch/CNC_Modeling/data/
# Хранилище, которое создают локальные прогоны тестов из папки launch
launch/data/
launch/data-preserve-*/
# То же хранилище, когда тест запускают из корня репозитория
/data/
launch/_occt_probe/
native/occt-bridge/build/

